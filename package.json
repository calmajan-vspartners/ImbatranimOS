{
  "name": "imbatranimos",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "workspaces": [
    "apps/backend",
    "apps/core",
    "apps/add-ons/*",
    "apps/docs",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "docker compose -f infrastructure/docker-compose.yml --profile dev watch",
    "dev:local": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format:check": "turbo format:check",
    "docs": "turbo run docs",
    "install:tooling": "npm install --ignore-scripts"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "turbo": "^2.10.5"
  },
  "allowScripts": {
    "argon2": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true,
    "node-pty": true,
    "protobufjs": true,
    "sharp": true,
    "unrs-resolver": true,
    "vue-demi": true
  }
}
