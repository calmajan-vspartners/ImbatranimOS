node_modules/
dist/
.turbo/
build/
*.local
.env
.env.*
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
# Local dev state: sqlite db + notes/configs created by `npm run dev`
/data/

# Generated docs artifacts (apps/docs) — narrative synced from corpus,
# reference generated from source; both rebuilt by `npm run docs`.
apps/docs/dist/
apps/docs/.astro/
apps/docs/public/reference/
apps/docs/src/content/docs/wiki/
.compodoc/
documentation/

# Personal / local / identifiable data — never commit
*.bak
*.bak.*
*.log
# Anchored to the repo root ON PURPOSE. An unanchored `logs/` matches a
# directory called `logs` at ANY depth, which silently swallowed
# `apps/backend/src/modules/logs/` and `apps/add-ons/logs/` when brief 84 added
# them — a commit that pushed a build no fresh clone could produce. The runtime
# log this rule is for lives in the home volume, outside the repo entirely.
/logs/
# OS + editor cruft (machine-identifiable)
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
